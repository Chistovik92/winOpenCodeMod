import type { Rpc } from " @opencode/plugin/rpc\

const modelSchema = {
 type: \object\,
 properties: {
 id: { type: \string\ },
 name: { type: \string\ },
 },
 required: [\id\, \name\],
}

const providerSchema = {
 type: \object\,
 properties: {
 id: { type: \string\ },
 name: { type: \string\ },
 baseURL: { type: \string\ },
 apiKey: { type: \string\ },
 headers: { type: \object\, additionalProperties: { type: \string\ } },
 models: { type: \array\, items: modelSchema },
 },
 required: [\id\, \name\, \baseURL\, \models\],
}

const externalProviderSchema = {
 type: \object\,
 properties: {
 id: { type: \string\ },
 name: { type: \string\ },
 kind: { type: \string\, enum: [\custom\, \builtin\] },
 package: { type: \string\ },
 baseURL: { type: \string\ },
 apiKey: { type: \string\ },
 headers: { type: \object\, additionalProperties: { type: \string\ } },
 modelCount: { type: \number\ },
 overridden: { type: \boolean\ },
 },
 required: [\id\, \name\, \kind\, \package\, \modelCount\, \overridden\],
}

const overrideSchema = {
 type: \object\,
 properties: {
 id: { type: \string\ },
 name: { type: \string\ },
 baseURL: { type: \string\ },
 apiKey: { type: \string\ },
 headers: { type: \object\, additionalProperties: { type: \string\ } },
 },
 required: [\id\],
}

const emptySchema = {
 type: \object\,
 properties: {},
 additionalProperties: false,
}

const importResultSchema = {
 type: \object\,
 properties: {
 added: { type: \array\, items: { type: \string\ } },
 updated: { type: \array\, items: { type: \string\ } },
 overridden: { type: \array\, items: { type: \string\ } },
 skipped: {
 type: \array\,
 items: {
 type: \object\,
 properties: {
 id: { type: \string\ },
 reason: { type: \string\ },
 },
 required: [\id\, \reason\],
 },
 },
 errors: { type: \array\, items: { type: \string\ } },
 },
 required: [\added\, \updated\, \overridden\, \skipped\, \errors\],
}

const aiStarModelSchema = {
 type: \object\,
 properties: {
 id: { type: \string\ },
 display_name: { type: \string\ },
 context_window: { type: \string\ },
 multiplier: { type: \number\ },
 modalities: { type: \string\ },
 isNew: { type: \boolean\ },
 uptime: { type: \number\ },
 quality: { type: [\number\, \null\] },
 effort: { type: \array\, items: { type: \string\ } },
 category: { type: \string\ },
 category_label: { type: \string\ },
 category_label_en: { type: \string\ },
 },
 required: [\id\, \display_name\, \context_window\, \multiplier\, \modalities\, \isNew\, \uptime\, \effort\, \category\, \category_label\, \category_label_en\],
}

const aiStarActivateResponseSchema = {
 type: \object\,
 properties: {
 access_code: { type: \string\ },
 api_key: { type: \string\ },
 service: { type: \string\ },
 limit: { type: \number\ },
 used: { type: \number\ },
 activated_at: { type: \string\ },
 base_url: { type: \string\ },
 },
 required: [\access_code\, \api_key\, \service\, \limit\, \used\, \activated_at\, \base_url\],
}

export const ProviderRpc = {
 id: \winopencodemod\,
 methods: {
 list: {
 input: emptySchema,
 output: {
 type: \object\,
 properties: {
 providers: { type: \array\, items: providerSchema },
 externalProviders: { type: \array\, items: externalProviderSchema },
 existingProviderIDs: { type: \array\, items: { type: \string\ } },
 },
 required: [\providers\, \externalProviders\, \existingProviderIDs\],
 },
 },
 save: {
 input: providerSchema,
 output: emptySchema,
 },
 remove: {
 input: {
 type: \object\,
 properties: { id: { type: \string\ } },
 required: [\id\],
 },
 output: emptySchema,
 },
 saveOverride: {
 input: overrideSchema,
 output: emptySchema,
 },
 removeOverride: {
 input: {
 type: \object\,
 properties: { id: { type: \string\ } },
 required: [\id\],
 },
 output: emptySchema,
 },
 importProviders: {
 input: {
 type: \object\,
 properties: {
 paths: { type: \array\, items: { type: \string\ } },
 },
 required: [\paths\],
 },
 output: importResultSchema,
 },
 aiStarActivate: {
 input: {
 type: \object\,
 properties: {
 accessCode: { type: \string\ },
 },
 required: [\accessCode\],
 },
 output: aiStarActivateResponseSchema,
 },
 aiStarFetchModels: {
 input: {
 type: \object\,
 properties: {
 apiKey: { type: \string\ },
 },
 required: [\apiKey\],
 },
 output: {
 type: \object\,
 properties: {
 models: { type: \array\, items: aiStarModelSchema },
 },
 required: [\models\],
 },
 },
 aiStarFetchBootstrapModels: {
 input: emptySchema,
 output: {
 type: \object\,
 properties: {
 models: { type: \array\, items: aiStarModelSchema },
 },
 required: [\models\],
 },
 },
 },
 events: {},
} as const satisfies Rpc.PortableDefinition
